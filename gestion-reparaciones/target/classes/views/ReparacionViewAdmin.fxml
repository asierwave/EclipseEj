<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="vista-container" stylesheets="@/styles/reparacion.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="com.reparaciones.controllers.ReparacionControllerAdmin">

    <padding>
        <Insets bottom="40" left="40" right="40" top="40" />
    </padding>

    <!-- Barra superior -->
    <HBox alignment="CENTER_LEFT" spacing="24" styleClass="barra-superior">
        <VBox.margin>
            <Insets bottom="8" />
        </VBox.margin>

        <Label styleClass="vista-titulo" text="Historial de reparaciones" />

        <TextField fx:id="campoBusqueda" promptText="Busca una reparación por componente, reparador...." styleClass="buscador" HBox.hgrow="ALWAYS" />

        <Button fx:id="btnAniadir" onAction="#abrirFormularioAniadir" styleClass="btn-primary" text="Añadir reparación +" />

        <Button fx:id="btnDescargar" onAction="#descargarHistorial" styleClass="btn-secondary" text="Descargar Historial (Formato TXT)" />

    </HBox>

    <!-- Tabla -->
    <TableView fx:id="tablaReparaciones" styleClass="tabla-reparaciones" VBox.vgrow="ALWAYS">

        <columns>
            <TableColumn fx:id="colAcciones" maxWidth="80" minWidth="80" text="" />
            <TableColumn fx:id="colIdRep" minWidth="110" text="Id Reparación" />
            <TableColumn fx:id="colImei" minWidth="130" text="IMEI teléfono" />
            <TableColumn fx:id="colReparador" minWidth="100" text="Reparador" />
            <TableColumn fx:id="colFecha" minWidth="110" text="Fecha" />
            <TableColumn fx:id="colComponente" minWidth="150" text="Componente" />
            <TableColumn fx:id="colObservaciones" minWidth="200" text="Observaciones" />
            <TableColumn fx:id="colIncidencia" minWidth="200" text="Incidencia" />
            <TableColumn fx:id="colIdAnterior" minWidth="150" text="Id Rep. Anterior" />
        </columns>

    </TableView>

</VBox>
